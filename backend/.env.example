# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-flask-secret-key-here
FLASK_DEBUG=True
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:your-db-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Image Generation ──────────────────────────────────────────────────────────
# Unsplash — free tier: 50 requests/hour — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Google Gemini — model-wearing images (Images 6–8)
# Requires a GCP project with billing linked — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend — https://resend.com (free: 3,000 emails/month)
RESEND_API_KEY=re_your_resend_key_here
# Free tier (no verified domain): must use onboarding@resend.dev as the FROM address
# With a verified domain: use any address on that domain
EMAIL_FROM=TaskHub <onboarding@resend.dev>

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local dev: path to service account JSON downloaded from Firebase Console
FIREBASE_CREDENTIALS_PATH=/path/to/your/firebase-adminsdk.json
# Production (Vercel): paste the full JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
